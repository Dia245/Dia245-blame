<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 350" width="800" height="350">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0d0d0d"/>
      <stop offset="100%" style="stop-color:#1a0000"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#005599;stop-opacity:0.25"/>
      <stop offset="100%" style="stop-color:transparent;stop-opacity:0"/>
    </radialGradient>
  </defs>

  <!-- Fondo -->
  <rect width="800" height="350" fill="url(#bg)"/>
  <ellipse cx="400" cy="175" rx="350" ry="200" fill="url(#glow)"/>

  <!-- Línea decorativa -->
  <line x1="0" y1="320" x2="800" y2="320" stroke="#005599" stroke-width="2" opacity="0.5"/>
  <line x1="0" y1="30" x2="800" y2="30" stroke="#005599" stroke-width="1" opacity="0.2"/>

  <!-- Moto SVG simplificada -->
  <!-- Cuerpo principal -->
  <ellipse cx="400" cy="175" rx="160" ry="55" fill="#005599" opacity="0.9"/>
  <!-- Tanque -->
  <ellipse cx="365" cy="148" rx="75" ry="28" fill="#005599"/>
  <!-- Asiento -->
  <ellipse cx="430" cy="148" rx="55" ry="18" fill="#333"/>
  <!-- Faro delantero -->
  <circle cx="558" cy="178" r="22" fill="#222" stroke="#005599" stroke-width="2"/>
  <circle cx="558" cy="178" r="14" fill="#ffe066" opacity="0.8"/>
  <!-- Espejo -->
  <line x1="530" y1="148" x2="510" y2="128" stroke="#555" stroke-width="3"/>
  <ellipse cx="506" cy="125" rx="8" ry="5" fill="#444"/>
  <!-- Horquilla delantera -->
  <line x1="538" y1="178" x2="520" y2="218" stroke="#444" stroke-width="5"/>
  <line x1="548" y1="178" x2="530" y2="218" stroke="#444" stroke-width="5"/>
  <!-- Rueda delantera -->
  <circle cx="525" cy="228" r="52" fill="none" stroke="#555" stroke-width="8"/>
  <circle cx="525" cy="228" r="52" fill="none" stroke="#005599" stroke-width="2" opacity="0.5"/>
  <circle cx="525" cy="228" r="18" fill="#333"/>
  <circle cx="525" cy="228" r="6" fill="#005599"/>
  <!-- Rayos delanteros -->
  <line x1="525" y1="176" x2="525" y2="280" stroke="#555" stroke-width="2"/>
  <line x1="473" y1="228" x2="577" y2="228" stroke="#555" stroke-width="2"/>
  <line x1="489" y1="191" x2="561" y2="265" stroke="#555" stroke-width="2"/>
  <line x1="561" y1="191" x2="489" y2="265" stroke="#555" stroke-width="2"/>
  <!-- Chasis trasero -->
  <line x1="390" y1="185" x2="280" y2="218" stroke="#444" stroke-width="6"/>
  <!-- Rueda trasera -->
  <circle cx="270" cy="228" r="55" fill="none" stroke="#555" stroke-width="8"/>
  <circle cx="270" cy="228" r="55" fill="none" stroke="#005599" stroke-width="2" opacity="0.5"/>
  <circle cx="270" cy="228" r="18" fill="#333"/>
  <circle cx="270" cy="228" r="6" fill="#005599"/>
  <!-- Rayos traseros -->
  <line x1="270" y1="173" x2="270" y2="283" stroke="#555" stroke-width="2"/>
  <line x1="215" y1="228" x2="325" y2="228" stroke="#555" stroke-width="2"/>
  <line x1="231" y1="189" x2="309" y2="267" stroke="#555" stroke-width="2"/>
  <line x1="309" y1="189" x2="231" y2="267" stroke="#555" stroke-width="2"/>
  <!-- Motor -->
  <rect x="295" y="190" width="65" height="45" rx="6" fill="#2a2a2a" stroke="#444" stroke-width="2"/>
  <rect x="305" y="198" width="20" height="12" rx="2" fill="#333"/>
  <rect x="335" y="198" width="20" height="12" rx="2" fill="#333"/>
  <!-- Escape -->
  <path d="M 295 220 Q 260 240 240 255" stroke="#666" stroke-width="6" fill="none" stroke-linecap="round"/>
  <!-- Manillar -->
  <line x1="530" y1="148" x2="560" y2="148" stroke="#666" stroke-width="5"/>
  <line x1="560" y1="148" x2="560" y2="162" stroke="#666" stroke-width="5"/>
  <!-- Pedal / pie -->
  <line x1="345" y1="225" x2="320" y2="238" stroke="#555" stroke-width="4"/>
  <line x1="320" y1="238" x2="300" y2="238" stroke="#005599" stroke-width="4"/>

  <!-- Textos -->
  <text x="400" y="310" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#666" letter-spacing="3">GLOBAL GO MOTOCICLETAS</text>
  <text x="60" y="80" font-family="Arial,sans-serif" font-size="48" font-weight="900" fill="#005599" opacity="0.12">110cc</text>

  <!-- Brillo superior -->
  <rect x="0" y="0" width="800" height="2" fill="#005599" opacity="0.4"/>
</svg>